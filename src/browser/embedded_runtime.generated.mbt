  #| class BrowserChildResource {
  #|   constructor(operator, handle, path, releaseExport) {
  #|     this.operator = operator;
  #|     this.facade = operator.facade;
  #|     this.handle = handle;
  #|     this.path = path;
  #|     this.releaseExport = releaseExport;
