supported_targets = "+native+js"

import {
  "Eric-Song-Nop/opendal/browser",
  "moonbitlang/async",
  "moonbitlang/async/pipe",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/env",
} for "test"

options(
