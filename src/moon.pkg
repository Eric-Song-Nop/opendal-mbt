    "error.mbt": [ "native" ],
    "error_wbtest.mbt": [ "native" ],
    "layers.mbt": [ "native" ],
    "layers_wbtest.mbt": [ "native" ],
    "listing.mbt": [ "native" ],
    "metadata.mbt": [ "native" ],
    "native_ffi.mbt": [ "native" ],
    "opendal_difficult_test.mbt": [ "native" ],
    "opendal_easy_test.mbt": [ "native" ],
    "opendal_mid_test.mbt": [ "native" ],
    "opendal_native_test.mbt": [ "native" ],
