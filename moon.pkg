// The public contract is target-independent. Native FFI files will be gated
// explicitly when the implementation phase starts.

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

options(
  "native-stub": [ "opendal_stub.c" ],
  targets: {
    "opendal_native.mbt": [ "native" ],
    "opendal_native_test.mbt": [ "native" ],
  },
  link: { "native": { "cc-link-flags": "-Ltarget/debug -lopendal_mbt_native" } },
)
