// The public contract is target-independent. Native FFI files are gated to
// the native target while the safe API remains available to every target.

import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/env",
} for "test"

options(
  "native-stub": [ "opendal_stub.c" ],
  targets: {
    "opendal_native.mbt": [ "native" ],
    "opendal_native_test.mbt": [ "native" ],
  },
  // The build entry point supplies the active Cargo profile through
  // LIBRARY_PATH so debug and release MoonBit tests link the matching archive.
  link: { "native": { "cc-link-flags": "-lopendal_mbt_native" } },
)
